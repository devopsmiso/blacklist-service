{
  "info": {
    "name": "Blacklist Service - Entrega 1",
    "description": "Microservicio de lista negra global de emails (DevOps - Uniandes).\n\nVariables de la colección:\n- `base_url`: http://localhost:5000 en local, o la URL del ambiente de AWS Beanstalk.\n- `token`: Bearer Token estático generado con `flask generate-token`.\n- `test_email`: se genera automáticamente para que las pruebas sean repetibles.\n\nEjecutar la colección en orden (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('test_email')) {",
          "    pm.collectionVariables.set('test_email', `cliente.${Date.now()}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "test_email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('incluye la versión', () => pm.expect(pm.response.json().version).to.be.a('string'));",
                  "console.log('Versión desplegada:', pm.response.json().version);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Endpoint usado por los health checks de AWS Beanstalk. No requiere token. Retorna la versión desplegada: durante una estrategia de despliegue permite ver qué versión atiende cada instancia.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "POST /blacklists",
      "item": [
        {
          "name": "Agregar email a la lista negra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('mensaje de confirmación', () => pm.expect(pm.response.json().message).to.include('agregado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Agrega un email a la lista negra global. `blocked_reason` es opcional (máx. 255).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"9f1c3a52-7d4b-4c1e-9a3f-2b8e6d0c1a77\",\n  \"blocked_reason\": \"Solicitud del cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Email duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Un email que ya está en la lista negra no se vuelve a agregar.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"9f1c3a52-7d4b-4c1e-9a3f-2b8e6d0c1a77\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errores por campo', () => {",
                  "    const errors = pm.response.json().errors;",
                  "    pm.expect(errors).to.have.all.keys('email', 'app_uuid', 'blocked_reason');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Email con formato inválido, app_uuid que no es UUID y motivo de más de 255 caracteres.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-un-email\",\n  \"app_uuid\": \"123\",\n  \"blocked_reason\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Sin Bearer Token la solicitud es rechazada.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"9f1c3a52-7d4b-4c1e-9a3f-2b8e6d0c1a77\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "GET /blacklists/<email>",
      "item": [
        {
          "name": "Consultar email en la lista negra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('está en la lista negra', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.is_blacklisted).to.be.true;",
                  "    pm.expect(body.blocked_reason).to.eql('Solicitud del cliente');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blacklists/{{test_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists",
                "{{test_email}}"
              ]
            },
            "description": "Retorna `is_blacklisted: true` y el motivo por el que fue agregado.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar email que no está",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no está en la lista negra', () => pm.expect(pm.response.json().is_blacklisted).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blacklists/no.existe@example.com",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists",
                "no.existe@example.com"
              ]
            },
            "description": "Retorna `is_blacklisted: false` y `blocked_reason: null`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Token inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blacklists/{{test_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists",
                "{{test_email}}"
              ]
            },
            "description": "Un token que no fue firmado por el servicio es rechazado.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token-invalido",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
