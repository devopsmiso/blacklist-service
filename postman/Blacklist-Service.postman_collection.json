    {
      "name": "GET /blacklists/<email>",
      "item": [
        {
          "name": "Consultar email en la lista negra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('está en la lista negra', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.is_blacklisted).to.be.true;",
                  "    pm.expect(body.blocked_reason).to.eql('Solicitud del cliente');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blacklists/{{test_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists",
                "{{test_email}}"
              ]
            },
            "description": "Retorna `is_blacklisted: true` y el motivo por el que fue agregado.",
            "auth": {
              "type": "bearer",
              "bearer": [
