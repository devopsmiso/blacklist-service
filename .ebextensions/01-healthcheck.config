# Configuración del ambiente de AWS Elastic Beanstalk que viaja con el código.
# Los valores definidos directamente en la consola tienen prioridad sobre este
# archivo; por eso en la consola se configuran los mismos valores.

option_settings:
  # Health check del Application Load Balancer sobre las instancias.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: "200"
    HealthCheckInterval: "15"
    HealthCheckTimeout: "5"
    HealthyThresholdCount: "3"
    UnhealthyThresholdCount: "5"
    # 20 s en lugar de 300 s para que cada lote de un despliegue no espere 5 minutos.
    DeregistrationDelay: "20"
  # Health reporting mejorado (estado por instancia en la pestaña Health).
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
